# === AgentAudit Configuration Example ===

# Groq API key for the semantic (LLM-as-judge) evaluator
# Get your API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Database URL (default: SQLite file in project root)
DATABASE_URL=sqlite+aiosqlite:///./agentaudit.db

# Semantic evaluator model (Groq model ID)
SEMANTIC_MODEL=openai/gpt-oss-20b

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable semantic evaluator (set to false for hard-rules only)
ENABLE_SEMANTIC=true
